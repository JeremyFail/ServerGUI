<?xml version="1.0" encoding="UTF-8"?>
<!--
  Material Deep Ocean editor color scheme for RSyntaxTextArea.
  Based on the Material Theme by Elior Boukhobza (MIT License).
  Original source: https://github.com/equinusocio/material-theme
  Variant: Deep Ocean - extremely dark blue-black background, lowest contrast.
  Characteristic Material Theme syntax colors shared across all MT variants.
-->
<scheme name="Material Deep Ocean" dark="true">
    <!-- near-black deep blue -->
    <background>0f111a</background>
    <!-- muted blue-gray foreground -->
    <foreground>8f93a2</foreground>
    <caret>ffffff</caret>
    <!-- dark navy selection -->
    <selection-background>1f2233</selection-background>
    <selection-foreground>8f93a2</selection-foreground>
    <!-- slightly lighter panel -->
    <line-highlight>131520</line-highlight>
    <gutter-background>0f111a</gutter-background>
    <!-- very muted blue-gray -->
    <gutter-foreground>3b3f51</gutter-foreground>

    <!-- purple - Material Theme signature -->
    <token type="keyword"          fg="c792ea" bold="true"/>
    <!-- blue -->
    <token type="keyword2"         fg="82aaff"/>
    <!-- very dark blue-gray - minimal comments -->
    <token type="comment"          fg="464b5d" italic="true"/>
    <!-- sage green -->
    <token type="comment-keyword"  fg="c3e88d"/>
    <!-- sage green -->
    <token type="string"           fg="c3e88d"/>
    <!-- peach/orange -->
    <token type="number"           fg="f78c6c"/>
    <!-- blue -->
    <token type="function"         fg="82aaff"/>
    <!-- near-white -->
    <token type="variable"         fg="eeffff"/>
    <!-- golden yellow -->
    <token type="type"             fg="ffcb6b"/>
    <!-- sage green -->
    <token type="regex"            fg="c3e88d"/>
    <!-- golden yellow -->
    <token type="annotation"       fg="ffcb6b"/>
    <!-- sky cyan -->
    <token type="operator"         fg="89ddff"/>
    <!-- peach/orange -->
    <token type="preprocessor"     fg="f78c6c"/>
    <!-- soft pink/red -->
    <token type="markup-tag"       fg="f07178"/>
    <!-- golden yellow -->
    <token type="markup-attr"      fg="ffcb6b"/>
    <!-- sage green -->
    <token type="markup-attr-value" fg="c3e88d"/>
    <!-- soft pink/red -->
    <token type="error"            fg="f07178"/>
</scheme>
