<?xml version="1.0" encoding="UTF-8"?>
<!--
  Darcula editor color scheme for RSyntaxTextArea.
  Based on the JetBrains Darcula color scheme, which is part of IntelliJ IDEA Community Edition
  (Apache License 2.0 - https://github.com/JetBrains/intellij-community).
  Color values used here are factual/functional and are not copyrightable as such.
-->
<scheme name="Darcula" dark="true">
    <background>2b2b2b</background>
    <foreground>a9b7c6</foreground>
    <caret>bbbbbb</caret>
    <selection-background>214283</selection-background>
    <line-highlight>323232</line-highlight>
    <gutter-background>313335</gutter-background>
    <gutter-foreground>606366</gutter-foreground>

    <token type="keyword"          fg="cc7832" bold="true"/>
    <token type="keyword2"         fg="cc7832" bold="true"/>
    <token type="comment"          fg="808080" italic="true"/>
    <token type="comment-keyword"  fg="a8c023"/>
    <token type="string"           fg="6a8759"/>
    <token type="number"           fg="6897bb"/>
    <token type="function"         fg="ffc66d"/>
    <token type="variable"         fg="a9b7c6"/>
    <token type="type"             fg="a9b7c6"/>
    <token type="regex"            fg="364135"/>
    <token type="annotation"       fg="bbb529"/>
    <token type="operator"         fg="a9b7c6"/>
    <token type="preprocessor"     fg="bbb529"/>
    <token type="markup-tag"       fg="e8bf6a"/>
    <token type="markup-attr"      fg="bababa"/>
    <token type="markup-attr-value" fg="a5c261"/>
    <token type="error"            fg="bc3f3c"/>
</scheme>
