<?xml version="1.0" encoding="UTF-8"?>
<!--
  Material Oceanic editor color scheme for RSyntaxTextArea.
  Based on the Material Theme by Elior Boukhobza (MIT License).
  Original source: https://github.com/equinusocio/material-theme
  Variant: Oceanic - teal-tinged dark greenish background, the original/classic variant.
  Characteristic Material Theme syntax colors shared across all MT variants.
-->
<scheme name="Material Oceanic" dark="true">
    <!-- classic Material teal-dark background -->
    <background>263238</background>
    <!-- cool steel blue-gray -->
    <foreground>b0bec5</foreground>
    <caret>ffffff</caret>
    <!-- darker teal selection -->
    <selection-background>314549</selection-background>
    <selection-foreground>b0bec5</selection-foreground>
    <!-- slightly darker panel -->
    <line-highlight>1e272c</line-highlight>
    <gutter-background>263238</gutter-background>
    <!-- teal-gray line numbers -->
    <gutter-foreground>546e7a</gutter-foreground>

    <!-- purple - Material Theme signature -->
    <token type="keyword"          fg="c792ea" bold="true"/>
    <!-- blue -->
    <token type="keyword2"         fg="82aaff"/>
    <!-- muted teal-gray - comments -->
    <token type="comment"          fg="546e7a" italic="true"/>
    <!-- sage green -->
    <token type="comment-keyword"  fg="c3e88d"/>
    <!-- sage green -->
    <token type="string"           fg="c3e88d"/>
    <!-- peach/orange -->
    <token type="number"           fg="f78c6c"/>
    <!-- blue -->
    <token type="function"         fg="82aaff"/>
    <!-- near-white -->
    <token type="variable"         fg="eeffff"/>
    <!-- golden yellow -->
    <token type="type"             fg="ffcb6b"/>
    <!-- sage green -->
    <token type="regex"            fg="c3e88d"/>
    <!-- golden yellow -->
    <token type="annotation"       fg="ffcb6b"/>
    <!-- sky cyan -->
    <token type="operator"         fg="89ddff"/>
    <!-- peach/orange -->
    <token type="preprocessor"     fg="f78c6c"/>
    <!-- soft pink/red -->
    <token type="markup-tag"       fg="f07178"/>
    <!-- golden yellow -->
    <token type="markup-attr"      fg="ffcb6b"/>
    <!-- sage green -->
    <token type="markup-attr-value" fg="c3e88d"/>
    <!-- soft pink/red -->
    <token type="error"            fg="f07178"/>
</scheme>
